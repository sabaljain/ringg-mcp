# Required. Workspace API key from Ringg dashboard -> Settings -> API Key.
# Shown only once at generation time.
RINGG_API_KEY=

# Optional. Defaults to https://prod-api.ringg.ai/ca/api/v0
# RINGG_BASE_URL=

# Optional. Set to 1 to verify the key against GET /workspace at startup.
# RINGG_VERIFY_ON_START=0

# Optional. error | warn | info | debug   (default: info). All output goes to stderr.
# RINGG_LOG_LEVEL=info

# Optional. Per-request timeout in milliseconds (default: 30000).
# RINGG_TIMEOUT_MS=30000

# Optional. Speech-to-text (Parrot) base URL. Uses the same RINGG_API_KEY.
# Defaults to https://prod-api.ringg.ai/stt/v1
# RINGG_STT_BASE_URL=

# Optional. Timeout for one transcription, upload included (default: 120000).
# RINGG_STT_TIMEOUT_MS=120000
