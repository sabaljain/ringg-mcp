{
  "name": "ringg-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server exposing the Ringg AI platform API over stdio.",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "ringg-mcp": "./dist/index.js" },
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "probe": "node scripts/probe.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:stdout": "bash scripts/check-stdout-purity.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
